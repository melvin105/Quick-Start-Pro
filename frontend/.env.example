# Copy this file to `.env` and fill in the values for your machine.
# `.env` is gitignored; this example is committed so everyone knows which
# variables the app expects.

# ─── Backend API ────────────────────────────────────────────────────────────
# Base URL of the Quick Start Pro backend, including the /api/v1 prefix.
# The Axios client (src/lib/api.ts) prepends this to every request, so paths in
# the service layer are written WITHOUT the prefix (e.g. api.post('/auth/login')).
# If unset, the client falls back to http://localhost:5000/api/v1 (the backend's
# default dev port).
VITE_API_URL=http://localhost:5000/api/v1

# ─── App URL (for QR codes) ─────────────────────────────────────────────────
# Public origin the app is served from, used to build self check-in QR links.
# If unset, falls back to the current browser origin.
VITE_APP_URL=http://localhost:5173

# ─── Supabase (client-side only) ────────────────────────────────────────────
# Project URL and ANON (public) key. Never put the Service Role Key here — it is
# a server-only secret and must not ship to the browser.
VITE_SUPABASE_URL=https://PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=
