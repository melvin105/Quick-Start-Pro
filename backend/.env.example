PORT=5000
DATABASE_URL=
JWT_SECRET=your_secret_here
PUBLIC_FLOW_SECRET=optional_separate_secret_for_public_qr_links
JWT_EXPIRES_IN=7d

# Supabase Storage (private file uploads: student photos, ID/licence docs).
# SUPABASE_URL is the project URL, e.g. https://xxxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY is the service role key — keep it secret, never
# commit it. Without both set, upload endpoints return 503 STORAGE_NOT_CONFIGURED.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
