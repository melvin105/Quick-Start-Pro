# Local API
PORT=5000
# Must be at least 32 characters — the server refuses to start otherwise.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-with-a-long-random-secret
# Refresh-token lifetime — how long a user stays signed in before having to log
# in again. The frontend silently swaps its short access token for a new one in
# the background, so this is the real "session length".
JWT_EXPIRES_IN=7d
# Access-token lifetime — the short-lived token sent on every API call. Kept
# small so a stolen access token is only useful briefly. Optional; defaults to
# 15m. Accepts any ms/vercel duration string (e.g. 15m, 30m, 1h).
JWT_ACCESS_EXPIRES_IN=15m
PUBLIC_FLOW_SECRET=replace-with-a-different-long-random-secret

# ─── Production hardening (safe to omit in local dev) ────────────────────────
# Comma-separated list of browser origins allowed to call the API. Leave unset
# in dev (all origins reflected); MUST be set in production, e.g.:
#   CORS_ORIGINS=https://app.quickstartpro.com,https://quickstartpro.com
CORS_ORIGINS=
# Number of reverse-proxy hops in front of the API, so req.ip (used by the rate
# limiters) reads the real client from X-Forwarded-For. 1 = a single proxy.
# Increase only if you add another hop (e.g. Cloudflare in front of Nginx = 2).
TRUST_PROXY_HOPS=1

# Supabase Postgres (Project Settings -> Database -> Connection string)
DATABASE_URL=postgresql://postgres.PROJECT_REF:YOUR_DATABASE_PASSWORD@POOLER_HOST:6543/postgres

# ─── Database TLS verification ───────────────────────────────────────────────
# The DB connection VERIFIES the server's certificate by default (guards against
# man-in-the-middle). Nothing to configure: the repo ships Supabase's public root
# CA at backend/certs/supabase-ca.crt and pins it automatically, so verification
# works out of the box. (Supabase's pooler does not chain to a browser-trusted
# root, so the system trust store alone can't verify it.)
#
# Overrides (optional):
#   SUPABASE_DB_CA_CERT_PATH=./certs/supabase-ca.crt   # use a different CA file
#   SUPABASE_DB_CA_CERT=-----BEGIN CERTIFICATE-----\n...  # inline PEM (secret mgr)
# You can refresh the bundled cert from the dashboard: Project Settings ->
# Database -> SSL configuration -> "Download certificate".
#
# Escape hatch ONLY for a local box that can't present the CA (never in prod):
#   DB_SSL_REJECT_UNAUTHORIZED=false   # encrypted but UNVERIFIED (logs a warning)
#   DB_SSL=disable                     # no TLS at all (local plain Postgres)

# Supabase Storage (server-side only; never expose the service-role key)
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key
